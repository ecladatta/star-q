{
  "name": "star-q",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "release": "GITHUB_TOKEN=\"$(gh auth token)\" release-it",
    "release:dry": "GITHUB_TOKEN=\"$(gh auth token)\" release-it --dry-run",
    "release:patch": "GITHUB_TOKEN=\"$(gh auth token)\" release-it patch",
    "release:minor": "GITHUB_TOKEN=\"$(gh auth token)\" release-it minor",
    "release:major": "GITHUB_TOKEN=\"$(gh auth token)\" release-it major",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "migrate:custom-entities": "tsx src/scripts/migrate-custom-entities.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concat-stream": "^2.0.0",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^1000.0.0",
    "drizzle-orm": "^0.45.2",
    "html-to-text": "^10.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "n3": "^2.1.1",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tar-stream": "^3.2.0",
    "uuid": "^14.0.1",
    "wikibase-sdk": "^11.6.4",
    "wtf_wikipedia": "^10.4.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@next/eslint-plugin-next": "^16.2.12",
    "@release-it/conventional-changelog": "^12.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/cli-progress": "^3.11.6",
    "@types/concat-stream": "^2.0.3",
    "@types/html-to-text": "^9.0.4",
    "@types/n3": "^1.26.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/tar-stream": "^3.1.4",
    "cli-progress": "^3.12.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.25",
    "release-it": "^21.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "**/*.{json,css,md}": [
      "eslint --fix"
    ]
  }
